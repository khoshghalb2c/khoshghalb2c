         <photoshop:TextLayers>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Achievements &amp; Awards</photoshop:LayerName>
                  <photoshop:LayerText>ACHIEVEMENTS &amp; AWARDS 1st Place â€“ ACM Programming Contest  (May 2023) C++ Programming  â€“ Farhikhtegan Javan National Student Competition       Science &amp; Research University, Tehran 1st Place â€“ Game Development Competition (Feb 2024) C# Programming with Unity Game Engine  â€“ Kibord Events, Hamrah Academy       Shahid Beheshti University, Tehran 1st Place â€“ Android App Design Competition (May 2024) Java Programming with Android Studio  â€“ Farhikhtegan Javan National Student Competition       Science &amp; Research University, Tehran</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Key Projects</photoshop:LayerName>
                  <photoshop:LayerText>KEY PROJECTS CardBank â€“ Secure Bank Card Manager   Technologies: Android (Java/Kotlin), SQLite, XML, Material Design   Published on: CafeBazaar &amp; Myket â€“ 3.8k+ installs, 4/5 rating   Role: Sole Developer &amp; Product Owner    â€¢ Designed a complete security layer (PIN-lock, encryption, backup/restore)   â€¢ Built a high-performance search algorithm filtering thousands of cards in milliseconds   â€¢ Added customizable theming (dark/light, color accents) based on user behavior   â€¢ Actively collected user feedback, prioritized requests, and released regular updates   â€¢ Owned the entire lifecycle from ideation to publishing and post-launch support</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Professional Summary</photoshop:LayerName>
                  <photoshop:LayerText>PROFESSIONAL SUMMARY Android developer with 5+ years of self-directed experience in designing, developing, and publishing high-quality mobile applications. Expert in Java, Android Studio, SQLite, and REST API integration. Proven track record of delivering user-centric solutions with a strong focus on security, performance, and continuous improvement based on real user feedback. Experienced in cross-functional team collaboration under tight deadlines. Passionate about creating practical, elegant, and efficient software that solves real-world problems.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Personal Info</photoshop:LayerName>
                  <photoshop:LayerText>SEYED ABOLFAZL KHOSHGHALB TOOSI Android Application Developer</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Update time</photoshop:LayerName>
